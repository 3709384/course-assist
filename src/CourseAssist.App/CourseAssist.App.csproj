<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Allow building this Windows app on non-Windows machines (CI / cross-build). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CourseAssist</AssemblyName>
    <RootNamespace>CourseAssist.App</RootNamespace>
    <Version>1.4.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CourseAssist.Core\CourseAssist.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- The bundles are compiled into the Core library (see tools/gen_bundles.py →
       BundlesData.cs), so the exe always carries them. They are also shipped as loose
       files next to the app as a fallback / drop-in update channel. -->
  <ItemGroup>
    <Content Include="..\..\bundles\*.yaml">
      <Link>bundles\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
