<Window x:Class="CourseAssist.App.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入门教程" Width="660" Height="760"
        WindowStartupLocation="CenterOwner" Background="#F5FAF7"
        FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Display">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="#047857"/>
      <TextBlock x:Name="VersionText" Foreground="#777777" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="#D3EADD" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,12,0,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <StackPanel>
          <TextBlock Text="界面示意图（图例）" FontWeight="Bold" Foreground="#047857" FontSize="14"/>
          <Border x:Name="DiagramHost" Margin="0,6,0,2"/>
          <TextBlock Text="示意图用来先认地方；真实截图看下方官方教程里的图文，版本与你装的一致。"
                     Foreground="#8A9A92" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="第一次用，照着这几步走" FontWeight="Bold" Foreground="#047857" FontSize="14" Margin="0,16,0,0"/>
          <StackPanel x:Name="StepsPanel" Margin="0,6,0,0"/>
          <TextBlock x:Name="NoteText" Foreground="#B26A00" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="OpenButton" Content="打开官方图文教程" Style="{StaticResource AccentButton}" Click="OpenButton_Click"/>
      <Button Content="关闭" Style="{StaticResource PlainButton}" Margin="0" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
