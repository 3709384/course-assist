<Window x:Class="CourseAssist.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course Assist · 课程环境一键配置" Width="1120" Height="720"
        WindowStartupLocation="CenterScreen" Background="#F4FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource AccentDeepBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                <TextBlock Text="Course Assist" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="选好课，环境一键配好" Foreground="#DFF1F8" FontSize="13" Margin="12,3,0,0"/>
                <Border Background="#FFFFFF" Opacity="0.92" CornerRadius="9" Padding="8,1" Margin="12,1,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderVersion" Text="" Foreground="#2F7EA3" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Course list -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D7EAF2" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="选择课程" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentDeepBrush}" Margin="14,12,14,6"/>
                    <ListBox x:Name="CourseList" BorderThickness="0" SelectionChanged="CourseList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Margin" Value="2,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DFF1F8"/>
                                        <Setter Property="Foreground" Value="#2F7EA3"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail -->
            <Grid Grid.Column="1" Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="CourseTitle" Text="← 先从左边选一门课" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentDeepBrush}"/>
                    <TextBlock x:Name="CourseSummary" TextWrapping="Wrap" Foreground="#555" FontSize="12.5" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CourseNotes" TextWrapping="Wrap" Foreground="#B26A00" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,8">
                    <StackPanel x:Name="ToolsPanel"/>
                </ScrollViewer>

                <Border Grid.Row="2" Background="White" BorderBrush="#D7EAF2" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="安装位置：" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2F7EA3"/>
                        <TextBox x:Name="InstallRootBox" Width="320" Padding="6,4"/>
                        <Button Content="浏览…" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Click="Browse_Click"/>
                        <TextBlock Text="（软件会装到这个目录的子文件夹里）" Foreground="#888" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="CheckButton" Content="① 环境体检" Style="{StaticResource PlainButton}" Click="Check_Click"/>
                    <Button x:Name="InstallButton" Content="② 一键配置" Style="{StaticResource AccentButton}" Click="Install_Click"/>
                    <Button x:Name="UninstallButton" Content="卸载并还原" Style="{StaticResource PlainButton}" Click="Uninstall_Click"/>
                    <Button x:Name="DiagButton" Content="导出诊断报告" Style="{StaticResource PlainButton}" Click="Diag_Click" IsEnabled="False"/>
                </StackPanel>

                <!-- Progress: only visible while an install is actually running. -->
                <Border x:Name="ProgressPanel" Grid.Row="4" Background="White" BorderBrush="#D7EAF2" BorderThickness="1"
                        CornerRadius="8" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProgressText" FontSize="13" Foreground="{StaticResource AccentDeepBrush}"/>
                        <ProgressBar x:Name="BusyBar" Height="8" Maximum="100" Value="0" Margin="0,6,0,0"
                                     Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Background="White" BorderBrush="#D7EAF2" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,12,4">
                            <TextBlock Text="运行日志" FontWeight="Bold" Foreground="{StaticResource AccentDeepBrush}"/>
                            <TextBlock Text="遇到问题时，点上方「导出诊断报告」把日志发给老师或同学" Foreground="#999" FontSize="11.5" Margin="10,1,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="LogList" BorderThickness="0" FontSize="12.5"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
