<Window x:Class="CourseAssist.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course Assist · 课程环境一键配置" Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource AccentDeepBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                <TextBlock Text="Course Assist" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="选好课，环境一键配好" Foreground="#DFF1F8" FontSize="13" Margin="12,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Course list -->
            <Border Grid.Column="0" BorderBrush="#CDE9F4" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="选择课程" FontWeight="Bold" Foreground="{StaticResource AccentDeepBrush}" Margin="14,12,14,6"/>
                    <ListBox x:Name="CourseList" BorderThickness="0" SelectionChanged="CourseList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- Detail -->
            <Grid Grid.Column="1" Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="CourseTitle" Text="← 先从左边选一门课" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentDeepBrush}"/>
                    <TextBlock x:Name="CourseSummary" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CourseNotes" TextWrapping="Wrap" Foreground="#B26A00" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,6">
                    <StackPanel x:Name="ToolsPanel"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,8">
                    <TextBlock Text="安装位置：" VerticalAlignment="Center"/>
                    <TextBox x:Name="InstallRootBox" Width="320" Padding="6,4"/>
                    <Button Content="浏览…" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBlock Text="（软件会装到这个目录的子文件夹里）" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="CheckButton" Content="① 环境体检" Style="{StaticResource PlainButton}" Click="Check_Click"/>
                    <Button x:Name="InstallButton" Content="② 一键配置" Style="{StaticResource AccentButton}" Click="Install_Click"/>
                    <Button x:Name="UninstallButton" Content="卸载并还原" Style="{StaticResource PlainButton}" Click="Uninstall_Click"/>
                    <Button x:Name="DiagButton" Content="导出诊断报告" Style="{StaticResource PlainButton}" Click="Diag_Click" IsEnabled="False"/>
                </StackPanel>

                <Border Grid.Row="4" BorderBrush="#CDE9F4" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource AccentDeepBrush}" Margin="6,4,6,2"/>
                            <ProgressBar x:Name="BusyBar" Height="6" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                        </StackPanel>
                        <ListBox x:Name="LogList" BorderThickness="0" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
