<Window x:Class="CourseAssist.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Course Assist · 课程环境一键配置" Width="1140" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4FAFC" Icon="app.ico"
        FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="RootBorder" BorderBrush="#A9CBDC" BorderThickness="1">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header (doubles as the window title bar) -->
        <Border Grid.Row="0" Background="{StaticResource AccentDeepBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <TextBlock Text="课" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Course Assist" Foreground="White" FontSize="19" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="选好课，环境一键配好" Foreground="#CFEAF4" FontSize="13" Margin="12,4,0,0" VerticalAlignment="Center"/>
                    <Border Background="White" CornerRadius="9" Padding="8,1" Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderVersion" Text="" Foreground="#2F7EA3" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button x:Name="MinBtn" Content="&#xE921;" Style="{StaticResource CaptionButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinBtn_Click"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxBtn_Click">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Course list -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D7EAF2" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="选择课程" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentDeepBrush}" Margin="16,14,16,6"/>
                    <TextBlock x:Name="CoursesFooter" DockPanel.Dock="Bottom" Foreground="#9DB4BD" FontSize="11.5" Margin="16,8,16,12"/>
                    <ListBox x:Name="CourseList" BorderThickness="0" SelectionChanged="CourseList_SelectionChanged"
                             ItemContainerStyle="{StaticResource CourseItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail -->
            <Grid Grid.Column="1" Margin="20,14,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="140"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="CourseTitle" Text="欢迎使用 Course Assist" FontSize="20" FontWeight="Bold" Foreground="#173F4D"/>
                    <TextBlock x:Name="CourseSummary" TextWrapping="Wrap" Foreground="#5A6B72" FontSize="13" Margin="0,5,0,0"
                               Text="它会帮你把一门课需要的软件全部自动装好、配好，装完在桌面建好课程文件夹——你只管选课。"/>
                    <TextBlock x:Name="CourseMeta" Foreground="#8AA0A8" FontSize="12" Margin="0,3,0,0"/>
                    <TextBlock x:Name="CourseNotes" TextWrapping="Wrap" Foreground="#B26A00" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,12,0,10">
                    <ScrollViewer x:Name="ToolsScroll" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}" Visibility="Collapsed" Padding="0,0,8,0">
                        <StackPanel x:Name="ToolsPanel"/>
                    </ScrollViewer>
                    <Border x:Name="EmptyState" Background="White" BorderBrush="#D7EAF2" BorderThickness="1" CornerRadius="14">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                            <Border Width="76" Height="76" CornerRadius="38" Background="#EFF7FA" HorizontalAlignment="Center">
                                <TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="从左边选一门课开始" FontSize="16" FontWeight="SemiBold" Foreground="#2F7EA3"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="这里会列出这门课要装的软件和可选版本。点「一键配置」，剩下的都交给它：自动安装、自动配环境、桌面建好课程文件夹。"
                                       Foreground="#7A8B91" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="White" BorderBrush="#D7EAF2" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="安装位置" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2F7EA3"/>
                        <TextBox x:Name="InstallRootBox" Width="330" Style="{StaticResource ModernTextBox}" Margin="10,0,0,0"/>
                        <Button Content="浏览…" Style="{StaticResource PlainButton}" Margin="10,0,0,0" Click="Browse_Click"/>
                        <TextBlock Text="软件会装到这个目录下的子文件夹里" Foreground="#9DB4BD" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="CheckButton" Content="① 环境体检" Style="{StaticResource PlainButton}" Click="Check_Click"/>
                        <Button x:Name="InstallButton" Content="② 一键配置" Style="{StaticResource AccentButton}" Click="Install_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="UninstallButton" Content="卸载并还原" Style="{StaticResource PlainButton}" Click="Uninstall_Click"/>
                        <Button x:Name="DiagButton" Content="导出诊断报告" Style="{StaticResource PlainButton}" Margin="0" Click="Diag_Click" IsEnabled="False"/>
                    </StackPanel>
                </DockPanel>

                <!-- Progress: only visible while an install is actually running. -->
                <Border x:Name="ProgressPanel" Grid.Row="4" Background="White" BorderBrush="#D7EAF2" BorderThickness="1"
                        CornerRadius="10" Padding="14,11" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProgressText" FontSize="13" Foreground="{StaticResource AccentDeepBrush}"/>
                        <ProgressBar x:Name="BusyBar" Height="8" Maximum="100" Value="0" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Background="White" BorderBrush="#D7EAF2" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="14,9,14,4" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentDeepBrush}" Margin="7,0,0,0"/>
                                <TextBlock Text="遇到问题时，点上方「导出诊断报告」把日志发给老师或同学" Foreground="#9DB4BD" FontSize="11.5" Margin="10,1,0,0"/>
                            </StackPanel>
                            <Button Content="清空" Style="{StaticResource GhostButton}" Padding="9,1" FontSize="11.5"
                                    DockPanel.Dock="Right" Click="ClearLog_Click"/>
                        </DockPanel>
                        <ListBox x:Name="LogList" BorderThickness="0" FontSize="12.5" ItemContainerStyle="{StaticResource LogItemStyle}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
